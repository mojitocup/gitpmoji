# Copy this file to .git/hooks folder first
# And only after change credentials

# Regex for sed command. emoji will be placed after it if found
#export GITPMOJI_PREFIX_RX="TICKET-[0-9]\{1,5\}:\{0,1\}"

# OpenAI Configuration
# Your api key you can get one here https://platform.openai.com/account/api-keys
#export GITPMOJI_API_KEY="sk-put-your-open-ai-api-key-here"
export GITPMOJI_API_BASE_URL="https://api.openai.com/v1"
export GITPMOJI_API_MODEL="gpt-4o"


# AWS Bedrock Configuration
# Set to true to enable AWS Bedrock, otherwise OpenAI will be used

#export GITPMOJI_USE_BEDROCK="true"
#export GITPMOJI_AWS_REGION="eu-central-1"
#export GITPMOJI_AWS_ACCESS_KEY_ID="your-aws-access-key"
#export GITPMOJI_AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
#export GITPMOJI_BEDROCK_MODEL="anthropic.claude-3-7-sonnet-20250219-v1:0"
